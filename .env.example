# ==============================================================================
# KONFIGURASI AKUN OUTREACH KHUSUS (DEDICATED & ISOLATED ACCOUNTS)
# ==============================================================================
# Petunjuk:
# Salin file ini menjadi `.env` di folder utama:
#   copy .env.example .env
#
# PENTING: Gunakan email dan nomor WhatsApp BARU/TERPISAH (bukan nomor pribadi)
# agar akun utama Anda 100% aman dari resiko banned, limit, atau spam filter.
# ==============================================================================

# 1. AKUN EMAIL KHUSUS (DEDICATED EMAIL / SMTP)
# Rekomendasi: Gunakan akun Gmail khusus baru atau email domain custom (e.g., halo@agensi-anda.com).
# Jika menggunakan Gmail baru:
# - Aktifkan 2-Step Verification di myaccount.google.com
# - Buat 'App Password' (16 digit) di: https://myaccount.google.com/apppasswords
OUTREACH_EMAIL_HOST=smtp.gmail.com
OUTREACH_EMAIL_PORT=587
OUTREACH_EMAIL_USER=outreach.studio.web@gmail.com
OUTREACH_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Nama & Identitas Pengirim Email
OUTREACH_SENDER_NAME=Studio Modernisasi Web
OUTREACH_SENDER_WA=+62 812-xxxx-xxxx

# 2. AKUN WHATSAPP KHUSUS (DEDICATED WHATSAPP)
# Sesi WhatsApp Web untuk Playwright disimpan terpisah di:
#   clients/.whatsapp_session/
# Anda TIDAK perlu memasukkan password di sini. Cukup jalankan perintah:
#   python auto_outreach.py --setup-wa
# Lalu scan QR code menggunakan nomor WhatsApp BARU Anda sekali saja.

# 3. KREDENSIAL VERCEL (AUTO-DEPLOYMENT CLOUD KE websiteadapter.vercel.app)
# Buat Personal Access Token di: https://vercel.com/account/tokens
VERCEL_TOKEN=

# 4. KREDENSIAL MIDTRANS (UANG $100 MASUK LANGSUNG KE REKENING BANK ANDA)
# Dapatkan Server Key & Client Key di: https://dashboard.midtrans.com (Settings > Access Keys)
# Untuk Sandbox/Testing: awali dengan SB-Mid-server-...
# Untuk Live/Production: awali dengan Mid-server-...
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

