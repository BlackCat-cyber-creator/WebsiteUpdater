# ==============================================================================
# KONFIGURASI AKUN OUTREACH KHUSUS (DEDICATED & ISOLATED ACCOUNTS)
# ==============================================================================
# Petunjuk:
# Salin file ini menjadi `.env` di folder utama:
#   copy .env.example .env
#
# PENTING: Gunakan email dan nomor WhatsApp BARU/TERPISAH (bukan nomor pribadi)
# agar akun utama Anda 100% aman dari resiko banned, limit, atau spam filter.
# ==============================================================================

# 1. AKUN EMAIL KHUSUS (DEDICATED EMAIL / SMTP)
# Rekomendasi: Gunakan akun Gmail khusus baru atau email domain custom (e.g., halo@agensi-anda.com).
# Jika menggunakan Gmail baru:
# - Aktifkan 2-Step Verification di myaccount.google.com
# - Buat 'App Password' (16 digit) di: https://myaccount.google.com/apppasswords
OUTREACH_EMAIL_HOST=smtp.gmail.com
OUTREACH_EMAIL_PORT=587
OUTREACH_EMAIL_USER=outreach.studio.web@gmail.com
OUTREACH_EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Nama & Identitas Pengirim Email
OUTREACH_SENDER_NAME=Studio Modernisasi Web
OUTREACH_SENDER_WA=+62 812-xxxx-xxxx

# 2. METODE DISPATCH WHATSAPP (PILIHAN: 'meta' atau 'playwright')
# 'meta'       = Official Meta WhatsApp Cloud API (Jalur 2 - 100% Anti-Ban, tanpa browser, 1.000 chat/bln gratis)
# 'playwright' = WhatsApp Web Browser Automation (Mode lama, butuh scan QR)
WA_PROVIDER=meta

# KREDENSIAL OFFICIAL META WHATSAPP CLOUD API (JALUR 2)
# Dapatkan di: https://developers.facebook.com/apps/ > WhatsApp > API Setup
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=website_updater_verify_token
# Nama template resmi jika menggunakan pesan template (opsional):
META_TEMPLATE_NAME=

# (Opsional jika memakai Playwright mode):
# Sesi WhatsApp Web untuk Playwright disimpan terpisah di: clients/.whatsapp_session/
# Jalankan perintah: python auto_outreach.py --setup-wa

# 3. KREDENSIAL VERCEL (AUTO-DEPLOYMENT CLOUD KE websiteadapter.vercel.app)
# Buat Personal Access Token di: https://vercel.com/account/tokens
VERCEL_TOKEN=

# 4. KREDENSIAL MIDTRANS (PEMBAYARAN Rp 1.490.000 MASUK LANGSUNG KE REKENING BANK ANDA)
# Dapatkan Server Key & Client Key di: https://dashboard.midtrans.com (Settings > Access Keys)
# Untuk Sandbox/Testing: awali dengan SB-Mid-server-...
# Untuk Live/Production: awali dengan Mid-server-...
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# 5. GOOGLE GEMINI AI API (AUTO-SYNTHESIZE SEMUA JENIS UKM KE STANDAR UI/UX PRO MAX)
# Dapatkan API Key GRATIS di: https://aistudio.google.com/app/apikey
# Digunakan untuk otomatis meracik 6 katalog produk fisik konkret, copywriting, keunggulan & FAQ
# untuk SEMUA jenis UKM (Apotek, Florist, Bengkel Bubut, Toko Roti, Pet Shop, dll)
# Model rekomendasi: gemini-3.7-flash, gemini-3.8-flash, atau gemini-3.1-flash-lite.
# Sistem secara otomatis memiliki cascade fallback jika satu model kehabisan kuota gratis harian.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 6. DASHBOARD SECURITY TOKEN (MELINDUNGI DASHBOARD LOKAL DARI AKSES TIDAK SAH)
# Jika tidak diisi, token akan di-generate otomatis saat server dimulai dan ditampilkan di terminal.
# Set token tetap di sini agar URL dashboard konsisten:
DASHBOARD_TOKEN=

